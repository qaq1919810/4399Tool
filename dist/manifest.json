{
  "manifest_version": 3,
  "name": "4399",
  "version": "0.0.3",
  "description": "4399",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {},
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "notifications"
  ],
  "host_permissions": [
    "*://*.4399.com/*",
    "<all_urls>"
  ]
}
