{
  "manifest_version": 3,
  "name": "4399",
  "version": "0.0.2",
  "description": "4399",

  "action": {
    "default_popup": "./html/popup/index.html"
  },

  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],

  "host_permissions": [
    "*://*.4399.com/*",
    "<all_urls>"
  ]
}
